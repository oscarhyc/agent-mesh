{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "openclaw/plugin-sdk/*": ["/opt/homebrew/lib/node_modules/openclaw/dist/plugin-sdk/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}